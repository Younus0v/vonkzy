# Copy this file to .env and fill in your real values.
# Never commit the real .env file - it's already in .gitignore.

# Twilio (from console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic (from console.anthropic.com)
ANTHROPIC_API_KEY=

# Set to true to skip real (paid) AI calls during testing - see ai.js
MOCK_AI=false

# Supabase (from your project's Settings > API page)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Calendar (service account - see CLAUDE.md for setup steps)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
MOCK_CALENDAR=true

# Server
PORT=3001